{
  "name": "@deapi/mastra-voice",
  "version": "0.1.1",
  "description": "deAPI voice provider for Mastra: text-to-speech (Kokoro, Chatterbox, Qwen3 TTS) and speech-to-text (Whisper Large V3)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mastra",
    "mastra-voice",
    "mastra-ai",
    "voice",
    "tts",
    "stt",
    "text-to-speech",
    "speech-to-text",
    "deapi",
    "kokoro",
    "whisper",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://github.com/deapi-ai/mastra-voice-deapi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deapi-ai/mastra-voice-deapi.git"
  },
  "bugs": {
    "url": "https://github.com/deapi-ai/mastra-voice-deapi/issues"
  },
  "author": "deAPI <media@deapi.ai>",
  "peerDependencies": {
    "@mastra/core": "^1.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@mastra/core": "^1.84.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
